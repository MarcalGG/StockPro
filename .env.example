# Copie este arquivo para .env.local (desenvolvimento) e configure os
# valores reais nas variaveis de ambiente da Vercel para producao.
# NUNCA coloque valores reais neste arquivo nem em nenhum arquivo commitado.

# Connection string do banco de dados.
# Desenvolvimento local (SQLite, sem instalar nada):
DATABASE_URL="file:./prisma/dev.db"
# Producao (Postgres — Vercel Postgres, Neon, Supabase etc.):
# DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"
# (troque tambem "provider" em prisma/schema.prisma de "sqlite" para "postgresql")

# Chave de criptografia AES-256 usada para guardar o certificado A1 (PEM da
# chave privada e do certificado) de forma criptografada no banco. Precisa
# ter exatamente 64 caracteres hexadecimais (32 bytes). Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar esta chave depois de ja existir certificado salvo invalida os
# certificados salvos (eles precisariam ser reenviados).
CERT_ENCRYPTION_KEY=

# Segredo usado para assinar o cookie de sessao do login administrativo.
# Gere com o mesmo comando acima.
SESSION_SECRET=

# Credenciais do primeiro usuario administrador, usadas apenas pelo script
# de seed (npx prisma db seed) para criar a conta inicial. Depois do
# primeiro login, recomendamos trocar a senha e remover estas variaveis.
ADMIN_EMAIL=
ADMIN_PASSWORD=
